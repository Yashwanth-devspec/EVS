# EcoRide Share — Environment Configuration Example

# Admin Dashboard Password (default: ecoride2026)
ADMIN_PASSWORD=ecoride2026

# Offline Mode / Routing overrides (1 to enable)
ECORIDE_OFFLINE=0
ECORIDE_NO_OSRM=0

# Custom Database Path (defaults to ./ecoride.db)
# ECORIDE_DB_PATH=./ecoride.db

# Geocoding Contact Email for Nominatim User-Agent
# ECORIDE_GEO_CONTACT=your-email@example.com

# Geocoding Fixture Mode (1 to use deterministic local mock coordinates)
ECORIDE_GEO_FIXTURES=0
